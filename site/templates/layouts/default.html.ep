<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Pyjoyment: glue, run and ship Python applications. Zero dependencies.">
    <title><%= c.title() %></title>
    <link rel="canonical" href="<%= canonical %>">
    <link rel="icon" href="<%= url_for('/favicon.svg') %>" type="image/svg+xml">
    <link rel="stylesheet" href="<%= url_for('/vendor/highlight.js/github.min.css') %>" media="(prefers-color-scheme: light)">
    <link rel="stylesheet" href="<%= url_for('/vendor/highlight.js/github-dark.min.css') %>" media="(prefers-color-scheme: dark)">
    <link rel="stylesheet" href="<%= url_for('/css/site.css') %>">
    <script src="<%= url_for('/vendor/highlight.js/highlight.min.js') %>" defer></script>
    % for language in ('dockerfile', 'nginx', 'powershell'):
      <script src="<%= url_for(f'/vendor/highlight.js/languages/{language}.min.js') %>" defer></script>
    % end
    <script src="<%= url_for('/js/hcl.js') %>" defer></script>
    <script src="<%= url_for('/js/site.js') %>" defer></script>
  </head>
  <body>
    <main><%= content() %></main>
    % import datetime
    <footer class="footer">
      <p class="copyright">© 2014–<%= datetime.date.today().year %> Piotr Roszatycki</p>
      <ul class="badges">
        % for href, src, alt in badges():
          <li>
            <a href="<%= href %>" target="_blank" rel="noopener"><img src="<%= src %>" alt="<%= alt %>" height="28"></a>
          </li>
        % end
      </ul>
    </footer>
  </body>
</html>
